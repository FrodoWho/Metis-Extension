{
  "manifest_version": 3,
  "name": "Measure",
  "version": "0.1.0",
  "description": "Inspect element dimensions and place alignment guides on any page.",
  "permissions": ["activeTab", "storage", "tabs"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M", "mac": "Alt+Shift+M" },
      "description": "Toggle the Measure toolbar"
    }
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
      "content/modules/overlay.js",
      "content/modules/guides.js",
      "content/modules/measure.js",
      "content/modules/toolbar.js",
      "content/content.js"
    ],
    "css": ["content/content.css"],
    "run_at": "document_idle"
  }]
}
